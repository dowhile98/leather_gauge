int32_t p10_read_serial(uint8_t* buf, uint16_t count, int32_t byte_timeout_ms, void* arg)
{
	HAL_GPIO_WritePin(DIR_DISPLAY_GPIO_Port, DIR_DISPLAY_Pin, GPIO_PIN_RESET); // Set direction to receive

	if(HAL_UART_Receive(&huart5, buf, count, byte_timeout_ms) != HAL_OK){
		return 0;
	}

	return count;
}


