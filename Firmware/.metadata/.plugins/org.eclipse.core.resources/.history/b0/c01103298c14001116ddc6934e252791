//-------------------------------------------------------------------------------

//-------------------------------------------------------------------------------
// private function prototype
//-------------------------------------------------------------------------------
static int32_t p10_read_serial(uint8_t* buf, uint16_t count, int32_t byte_timeout_ms, void* arg);
static int32_t p10_write_serial(const uint8_t* buf, uint16_t count, int32_t byte_timeout_ms, void* arg);
//-------------------------------------------------------------------------------
// task definition
//-------------------------------------------------------------------------------
static void lgc_p10_task_entry(void *params)
{
	LgcLiveStatus_t live_status;

	for(;;)
	{

		osDelayTask(500);
	}
}
//-------------------------------------------------------------------------------
// public function definition
//-------------------------------------------------------------------------------
uint8_t lgc_p10_init(void)
{
	OsTaskParameters params = OS_TASK_DEFAULT_PARAMS;
	/*init nmbs*/
	mbs_platform_conf_create(&platform_conf);
	platform_conf.transport = NMBS_TRANSPORT_RTU;
	platform_conf.read = p10_read_serial;
	platform_conf.write = p10_write_serial;

	nmbs_error err = nmbs_client_create(&nmbs, &platform_conf);
	if (err != NMBS_ERROR_NONE)
		return err;

	nmbs_set_read_timeout(&nmbs, 1000);
	nmbs_set_byte_timeout(&nmbs, 100);

	nmbs_set_destination_rtu_address(&nmbs, RTU_SERVER_ADDRESS);


	/*task create*/
}

//-------------------------------------------------------------------------------
// callbacks
//-------------------------------------------------------------------------------
static int32_t p10_read_serial(uint8_t* buf, uint16_t count, int32_t byte_timeout_ms, void* arg)
{
	HAL_GPIO_WritePin(DIR_DISPLAY_GPIO_Port, DIR_DISPLAY_Pin, GPIO_PIN_RESET); // Set direction to receive

	if(HAL_UART_Receive(&huart5, buf, count, byte_timeout_ms) != HAL_OK)
	{
		return 0;
	}

	return count;
}


static int32_t p10_write_serial(const uint8_t* buf, uint16_t count, int32_t byte_timeout_ms, void* arg)
{
	HAL_GPIO_WritePin(DIR_DISPLAY_GPIO_Port, DIR_DISPLAY_Pin, GPIO_PIN_SET); // Set direction to transmit

	if(HAL_UART_Transmit(&huart5, (uint8_t*)buf, count, byte_timeout_ms) != HAL_OK)
	{
		HAL_GPIO_WritePin(DIR_DISPLAY_GPIO_Port, DIR_DISPLAY_Pin, GPIO_PIN_RESET); // Set direction to receive
		return 0;
	}
	HAL_GPIO_WritePin(DIR_DISPLAY_GPIO_Port, DIR_DISPLAY_Pin, GPIO_PIN_RESET); // Set direction to receive
	return count;

}
